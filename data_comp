import os
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
import cv2
from tqdm import tqdm

# Video compression/extension
def compress_or_extend_video(input_path, output_path, target_fps=30, target_duration=1.0):
    cap = cv2.VideoCapture(input_path)
    if not cap.isOpened():
        print(f"Failed to open {input_path}")
        return False

    original_fps = cap.get(cv2.CAP_PROP_FPS) or 30
    frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    original_duration = frame_count / original_fps if frame_count > 0 else 1
    speed_factor = original_duration / target_duration
    new_frame_count = int(target_fps * target_duration)
    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

    fourcc = cv2.VideoWriter_fourcc(*'mp4v')
    out = cv2.VideoWriter(output_path, fourcc, target_fps, (width, height))

    for i in range(new_frame_count):
        original_frame_index = int(i * speed_factor)
        cap.set(cv2.CAP_PROP_POS_FRAMES, original_frame_index)
        ret, frame = cap.read()
        if not ret:
            break
        out.write(frame)

    cap.release()
    out.release()
    return True

# Process a single video
def process_video(file_path, output_folder):
    try:
        output_folder = Path(output_folder)
        output_folder.mkdir(parents=True, exist_ok=True)
        output_path = output_folder / Path(file_path).name

        success = compress_or_extend_video(file_path, str(output_path))
        if success:
            return f"✅ Saved {file_path} → {output_path}"
        else:
            return True
    except Exception as e:
        return False

# Process folder with progress bar
def process_folder(input_folder, output_folder, max_workers=8):
    """
    Process all videos in input_folder, saving results in output_folder using threading.
    """
    # Gather all video file paths
    videos = []
    for root, _, files in os.walk(input_folder):
        for file in files:
            if file.lower().endswith(('.mp4', '.avi', '.mov', '.mkv')):
                videos.append(os.path.join(root, file))

    # Ensure output folder exists
    os.makedirs(output_folder, exist_ok=True)

    # Helper function to process a single video
    def process_video(video_path):
        try:
            relative_path = os.path.relpath(video_path, input_folder)
            output_path = os.path.join(output_folder, relative_path)
            os.makedirs(os.path.dirname(output_path), exist_ok=True)
            compress_or_extend_video(video_path, output_path)
        except Exception as e:
            print(f"❌ Error processing {video_path}: {e}")

    # Threaded processing with progress bar
    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        list(tqdm(executor.map(process_video, videos),
                  total=len(videos),
                  desc="Processing Videos",
                  unit="video"))

# Example call
input_folder = "ASL_Citizen/videos"
output_folder = "DATA"
process_folder(input_folder, output_folder, max_workers=8)

if __name__ == "__main__":
    input_folder = "ASL_Citizen/videos"
    output_folder = "DATA"
    process_folder(input_folder, output_folder, max_workers=8)
